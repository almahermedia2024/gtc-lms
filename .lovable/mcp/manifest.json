          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "lecture_id": {
              "description": "Optional lecture id filter.",
              "type": "string"
            },
            "student_id": {
              "description": "Optional student id filter (admins only; students see their own rows).",
